# CI-only env for exercising the production topology (docker-compose.prod.yml)
# with the local auth backend. No real secrets here.
# APP_ENV_FILE points the app service's env_file back at this file.
APP_ENV_FILE=.env.ci
# Explicitly non-production: keeps the local auth backend and default API key
# allowed here. Real deployments must set APP_ENV=production (strict checks).
APP_ENV=ci
AUTH_BACKEND=local
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
LEGACY_X_API_KEY=local-x-api-key
DDB_TABLE_NAME=algodoo-main-ci
ASSET_S3_BUCKET=algodoo-assets
ASSET_PUBLIC_BASE_URL=http://localhost:9000/algodoo-assets
ASSET_S3_PUBLIC_ACL=false
ASSET_S3_AUTO_CREATE=false
S3_ADMIN_ACCESS_KEY=ci-s3-admin
S3_ADMIN_SECRET_KEY=ci-s3-admin-secret
S3_APP_ACCESS_KEY=ci-s3-app
S3_APP_SECRET_KEY=ci-s3-app-secret
SEED_DEMO_DATA=true
COOKIE_SECURE=false
WEB_CONCURRENCY=2
