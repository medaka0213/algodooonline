# Host-level reverse proxy in front of the compose stack.
# The app listens on 127.0.0.1:8080, the S3 gateway on 127.0.0.1:9000 (both loopback-only).
# Caddy obtains TLS certificates automatically.

example.com {
	reverse_proxy 127.0.0.1:8080
}

# Public asset delivery straight from the S3 gateway (anonymous read on IMAGE/ and DATA/ only).
# ASSET_PUBLIC_BASE_URL should be https://assets.example.com/<bucket-name>.
assets.example.com {
	reverse_proxy 127.0.0.1:9000
}
