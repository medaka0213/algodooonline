# Copy to .env.production, replace every <...> placeholder, and keep the file out of git.
# Launch: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Auth (real Amazon Cognito; reached over the internet) ---
AUTH_BACKEND=cognito
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=<ap-northeast-1_xxxxxxxxx>
# App client WITHOUT a client secret, with ALLOW_USER_PASSWORD_AUTH and
# ALLOW_REFRESH_TOKEN_AUTH enabled. If the client has a secret, also set
# COGNITO_CLIENT_SECRET.
COGNITO_CLIENT_ID=<xxxxxxxxxxxxxxxxxxxxxxxxxx>
COGNITO_CLIENT_SECRET=
# Match the user pool's refresh token validity (days).
COGNITO_REFRESH_TTL_DAYS=30

# --- Legacy API compatibility ---
# Required by every legacy JSON API route (SPEC §11). The app refuses to start
# with the local default value when AUTH_BACKEND=cognito.
LEGACY_X_API_KEY=<long-random-string>

# --- DynamoDB (self-hosted DynamoDB Local inside compose) ---
DDB_TABLE_NAME=algodoo-main

# --- Assets (self-hosted MinIO inside compose) ---
ASSET_S3_BUCKET=algodoo-assets
# Public URL that browsers use to fetch IMAGE/DATA objects, served by the host
# reverse proxy in front of MinIO (see deploy/Caddyfile.example).
ASSET_PUBLIC_BASE_URL=https://assets.example.com/algodoo-assets
# MinIO uses bucket policies (set by minio-init), not object ACLs.
ASSET_S3_PUBLIC_ACL=false
# minio-init owns bucket creation.
ASSET_S3_AUTO_CREATE=false

# --- MinIO credentials ---
MINIO_ROOT_USER=<random-user>
MINIO_ROOT_PASSWORD=<long-random-password>
# Dedicated app credentials created by minio-init (readwrite policy).
MINIO_APP_USER=<random-app-user>
MINIO_APP_PASSWORD=<long-random-app-password>

# --- Runtime ---
SEED_DEMO_DATA=false
COOKIE_SECURE=true
WEB_CONCURRENCY=2
